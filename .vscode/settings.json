{
  // Deliberately no "dart.flutterTestAdditionalArgs".
  //
  // Passing --dart-define-from-file=.env.local here breaks every test run
  // started inside packages/*: VS Code runs those with the package as the
  // working directory, .env.local only exists at the repo root, and the flag
  // is a hard error when the file is missing.
  //
  // The unit tests need no key — they stub the service. Only the integration
  // tests do, and they get it from the "Integration tests" launch
  // configuration in launch.json, which runs from the root.
}
